"""NESO DFS Monitor integration."""
from __future__ import annotations

import logging
from datetime import date, timedelta

import aiohttp

from homeassistant.config_entries import ConfigEntry
from homeassistant.const import Platform
from homeassistant.core import HomeAssistant
from homeassistant.helpers.update_coordinator import DataUpdateCoordinator, UpdateFailed

from .const import (
    CONF_SCAN_INTERVAL,
    DATE_FIELDS,
    DEFAULT_SCAN_INTERVAL,
    DOMAIN,
    NESO_API_URL,
    NESO_RESOURCE_ID,
    STATE_ACCEPTED,
    STATE_ERROR,
    STATE_NONE,
)

_LOGGER = logging.getLogger(__name__)

PLATFORMS = [Platform.SENSOR]


async def async_setup_entry(hass: HomeAssistant, entry: ConfigEntry) -> bool:
    """Set up NESO DFS Monitor from a config entry."""
    scan_interval = entry.data.get(CONF_SCAN_INTERVAL, DEFAULT_SCAN_INTERVAL)

    coordinator = NesoDfsCoordinator(
        hass,
        update_interval=timedelta(minutes=scan_interval),
    )

    await coordinator.async_config_entry_first_refresh()

    hass.data.setdefault(DOMAIN, {})
    hass.data[DOMAIN][entry.entry_id] = coordinator

    await hass.config_entries.async_forward_entry_setups(entry, PLATFORMS)
    return True


async def async_unload_entry(hass: HomeAssistant, entry: ConfigEntry) -> bool:
    """Unload the config entry."""
    unload_ok = await hass.config_entries.async_unload_platforms(entry, PLATFORMS)
    if unload_ok:
        hass.data[DOMAIN].pop(entry.entry_id)
    return unload_ok


class NesoDfsCoordinator(DataUpdateCoordinator):
    """Coordinator that fetches NESO DFS bid data on a schedule."""

    def __init__(self, hass: HomeAssistant, update_interval: timedelta) -> None:
        super().__init__(
            hass,
            _LOGGER,
            name=DOMAIN,
            update_interval=update_interval,
        )

    async def _async_update_data(self) -> dict:
        """Fetch data from the NESO API and return processed result."""
        today = str(date.today())
        sql = (
            f'SELECT * FROM "{NESO_RESOURCE_ID}" '
            f"WHERE \"SERVICE_PROVIDER\" ILIKE '%octopus%' "
            f"AND \"BID_STATUS\" ILIKE '%accepted%'"
        )

        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(
                    NESO_API_URL,
                    params={"sql": sql},
                    timeout=aiohttp.ClientTimeout(total=15),
                ) as resp:
                    resp.raise_for_status()
                    data = await resp.json()
        except aiohttp.ClientError as err:
            raise UpdateFailed(f"Error communicating with NESO API: {err}") from err
        except Exception as err:
            raise UpdateFailed(f"Unexpected error fetching NESO data: {err}") from err

        records = data.get("result", {}).get("records", [])

        # Filter for today only
        today_records = [
            r for r in records
            if any(str(r.get(f, ""))[:10] == today for f in DATE_FIELDS)
        ]

        # Extract unique directions (upward / downward)
        directions = list(
            {r.get("DIRECTION", r.get("SERVICE_TYPE", "Unknown")) for r in today_records}
        )

        state = STATE_ACCEPTED if today_records else STATE_NONE

        return {
            "state": state,
            "bid_count": len(today_records),
            "directions": directions,
            "last_checked": today,
            "raw_records": today_records[:10],  # cap payload size
        }
